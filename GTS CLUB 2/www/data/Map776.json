dent":1,"parameters":["cringe moments I don't wanna think about."]},{"code":231,"indent":1,"parameters":[1,"鸿2",0,0,300,0,75,75,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["But, that MTTUER said he'd make a new game based on the"]},{"code":401,"indent":1,"parameters":["story of Giant Girl Club,"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["but in the end there were many stories that "]},{"code":401,"indent":1,"parameters":["could've been explored that weren't covered. "]},{"code":401,"indent":1,"parameters":["What a waste."]},{"code":250,"indent":1,"parameters":[{"name":"1叮","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"鸿1",0,0,300,0,75,75,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["So I thought, how about I create a collab between my"]},{"code":401,"indent":1,"parameters":["game and MTTUER's game some day? "]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["It may be a little"]},{"code":401,"indent":1,"parameters":["arrogant, but wouldn't I be helping MTTUER fulfil "]},{"code":401,"indent":1,"parameters":["his unfulfilled dreams?"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["After all, every character's a kid worth caring for."]},{"code":401,"indent":1,"parameters":["To neglect them would be sad, wouldn't it be\"?"]},{"code":231,"indent":1,"parameters":[1,"鸿3",0,0,300,0,75,75,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["So, let's call it \"Gluttony Academy - The Dazed and"]},{"code":401,"indent":1,"parameters":["Confused Giant Girl Club Chapter\"~"]},{"code":235,"indent":1,"parameters":[1]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Where are we?"]},{"code":231,"indent":1,"parameters":[1,"鸿2",0,0,300,0,75,75,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["I dunno either. MTTUER said this is the technical"]},{"code":401,"indent":1,"parameters":["department made by the President, "]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["where the bloke named Chenfeng and I are to help with "]},{"code":401,"indent":1,"parameters":["the various technical difficulties encountered by "]},{"code":401,"indent":1,"parameters":["the club..."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["But it's actually quite obvious that the club's rooms"]},{"code":401,"indent":1,"parameters":["weren't programmed well, as there's not many maps left."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["This room's like something pulled out of thin air "]},{"code":401,"indent":1,"parameters":["from a certain blue, earless cat-shaped robot."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["Ugh, I get so angry talking about the technology."]},{"code":401,"indent":1,"parameters":["I dunno what got into MTTUER, "]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["but he insisted on making those Escape the Building, "]},{"code":401,"indent":1,"parameters":["and If you're a real man, go down 50 floors levels "]},{"code":401,"indent":1,"parameters":["memorisation challenges. It's torture!"]},{"code":250,"indent":1,"parameters":[{"name":"1打击","volume":90,"pitch":100,"pan":0}]},{"code":225,"indent":1,"parameters":[7,7,60,false]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["Worst part is, the club members that tested the game"]},{"code":401,"indent":1,"parameters":["thought I designed these insane levels for MTTUER..."]},{"code":401,"indent":1,"parameters":["What the hell! Do I look like some sadistic creator?"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["I kept suggesting making a shortcut to skip those"]},{"code":401,"indent":1,"parameters":["levels, so that even those who get lost can easily"]},{"code":401,"indent":1,"parameters":["get through... Ngh I gotta vent in my own game!"]},{"code":235,"indent":1,"parameters":[1]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"Game behind the scene stories"]},{"code":231,"indent":1,"parameters":[1,"鸿1",0,0,300,0,75,75,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["MTTUER said he wanted to make a queen-like character,"]},{"code":401,"indent":1,"parameters":["say as the Disciplinary Committee Chairperson, and "]},{"code":401,"indent":1,"parameters":["needed me to design a stomp minigame for her."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["【Xie Hong】"]},{"code":401,"indent":1,"parameters":["After hearing that the story was \"The chairwoman leads "]},{"code":401,"indent":1,"parameters":["the player to a trap\", "]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code"